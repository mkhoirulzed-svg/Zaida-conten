# Browserless API token. Keep this value private.
BROWSERLESS_TOKEN=

# Private secret used by the ZAIDA backend to call this worker.
# Generate a long random value; never put it in frontend code.
ZAIDA_WORKER_SECRET=

# Browserless shared fleet endpoint. Amsterdam is the initial test region;
# change this if account dashboard or latency tests recommend another region.
BROWSERLESS_WS_ENDPOINT=wss://production-ams.browserless.io

PORT=8787
NODE_ENV=production

# Pexels API key for automatic stock-video search. Keep this value private.
PEXELS_API_KEY=

# Exact frontend origins allowed to call the footage endpoint (comma-separated).
# Example: https://YOUR-USERNAME.github.io,https://your-custom-domain.com
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
